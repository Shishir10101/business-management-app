FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy csproj files and restore
COPY backend/src/Khata.Domain/Khata.Domain.csproj Khata.Domain/
COPY backend/src/Khata.Application/Khata.Application.csproj Khata.Application/
COPY backend/src/Khata.Infrastructure/Khata.Infrastructure.csproj Khata.Infrastructure/
COPY backend/src/Khata.Api/Khata.Api.csproj Khata.Api/
COPY backend/Khata.sln .
RUN dotnet restore Khata.sln

# Copy all source and build
COPY backend/ .
RUN dotnet publish src/Khata.Api/Khata.Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime

# QuestPDF renders through SkiaSharp, which needs fontconfig on Linux. The
# ASP.NET image does not ship it, and without it every invoice and backup PDF
# throws only at the moment a user asks for one — never at startup, so the
# failure hides until someone needs a document.
RUN apt-get update \
    && apt-get install -y --no-install-recommends fontconfig libfontconfig1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /app/publish .

# Most PaaS platforms inject PORT and route to that port; binding a fixed one
# leaves the service unreachable with no obvious error. Local runs fall back.
ENV ASPNETCORE_URLS=http://0.0.0.0:5000
EXPOSE 5000
ENTRYPOINT ["sh", "-c", "exec dotnet Khata.Api.dll --urls http://0.0.0.0:${PORT:-5000}"]
