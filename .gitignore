# =========================
# Nepal Digital Khata - Root .gitignore
# =========================

# --- Flutter / Dart ---
**/build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
# Lock files ARE committed: they pin the dependency graph that was tested.
# Ignoring pubspec.lock means a release build can silently resolve different
# package versions than the ones the test suite passed against.
coverage/
*.dart.js
*.js_
*.js.deps
*.js.map
.flutter/
app.*.symbols
app.*.map.json
android/.gradle/
android/captures/
android/gradlew
android/gradlew.bat
android/local.properties
android/**/google-services.json
ios/Pods/
ios/.symlinks/
ios/Flutter/Debug.xcconfig
ios/Flutter/Release.xcconfig
ios/Flutter/flutter_export_environment.sh
*.xcworkspace
*.xcconfig

# --- .NET / C# ---
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
[Bb]in/
[Oo]bj/
*.nupkg
*.snupkg
**/appsettings.Development.json
**/appsettings.Local.json
**/secrets.json
*.pfx
*.p12

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.tmproj
*.esproj

# --- OS ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Demo / local SQLite database ---
# Recreated from the model on startup (EnsureCreated), disposable by design.
khata_demo.db
khata_demo.db-shm
khata_demo.db-wal
*.db
*.db-shm
*.db-wal

# --- Environment / Secrets ---
.env
.env.*
*.pem
*.key
!infrastructure/**/*.env.example

# --- Android release signing ---
# The keystore and its passwords must never enter the repository. Losing them
# means the app can never be updated in place: Android only accepts an update
# signed with the same key. Back the keystore up somewhere that is not git.
**/key.properties
*.jks
*.keystore

# --- E2E artifacts ---
# Written by scripts/e2e/seed_demo_account.py; holds a live account password.
scripts/e2e/demo_account.json
scripts/e2e/walk.log
# Audit run output: regenerable, and dozens of PNGs.
scripts/e2e/audit_shots/
scripts/e2e/audit_report.json
# Newer audit run (audit_all_routes.py) — same reasoning, different filenames.
scripts/e2e/audit_all_shots/
scripts/e2e/audit_all_report.json
# Written by seed_ui_fixtures.py from demo_account.json; ids only, still derived.
scripts/e2e/ui_fixtures.json

# --- Docker ---
.docker/

# --- Logs ---
*.log
logs/

# --- Python ---
__pycache__/
*.pyc

# --- Build outputs ---
dist/
out/
artifacts/

# --- Test results ---
TestResults/
test-results/
coverage-results/

# --- WorkBuddy ---
.workbuddy-ai/
