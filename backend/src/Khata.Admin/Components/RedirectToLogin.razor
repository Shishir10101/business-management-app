@inject NavigationManager Navigation

@* Sends an unauthenticated operator to the login page, remembering where they
   were headed so a deep link survives the round trip. *@
@code {
    protected override void OnInitialized()
    {
        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: false);
    }
}
